{
  "name": "bigquery-local",
  "version": "0.6.0",
  "description": "Node.js + DuckDB local emulator for the Google BigQuery REST API. Drop-in for testing, CI, and local dev — with working PATCH.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "src": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "src": {
        "types": "./src/client.ts",
        "import": "./src/client.ts"
      },
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "bin": {
    "bigquery-local": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=src --test --test-reporter=spec",
    "test:coverage": "node --conditions=src --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "bigquery",
    "emulator",
    "duckdb",
    "typescript",
    "nodejs",
    "testing",
    "sql",
    "local-development",
    "gcp"
  ],
  "author": "JT Turner <jtwebman@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtwebman/bigquery-local.git"
  },
  "bugs": {
    "url": "https://github.com/jtwebman/bigquery-local/issues"
  },
  "homepage": "https://github.com/jtwebman/bigquery-local#readme",
  "dependencies": {
    "@duckdb/node-api": "1.5.2-r.1",
    "js-yaml": "4.1.1"
  },
  "peerDependencies": {
    "google-auth-library": ">=10"
  },
  "peerDependenciesMeta": {
    "google-auth-library": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@google-cloud/bigquery": "8.3.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "25.8.0",
    "google-auth-library": "10.6.2",
    "typescript": "6.0.3"
  }
}
